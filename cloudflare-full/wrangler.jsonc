{
  // Cloudflare Workers config for suganthan.com comments system.
  // IDs marked REPLACE_ME are filled in after creating D1/KV/R2 resources via wrangler.
  // Secrets (JWT_SECRET, TURNSTILE_SECRET) are NOT in this file. Set them via:
  //   wrangler secret put JWT_SECRET
  //   wrangler secret put TURNSTILE_SECRET
  "name": "suganthan-comments",
  "account_id": "f98bba70cc78b3d6bc6b42be9bc95959",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "comments-test.suganthan.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "suganthan-comments",
      "database_id": "bcb03e18-0f56-45ab-9e63-61514da86ecc"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "88480d0bd2b248fea759bb33f1b0f3c2",
      "preview_id": "88480d0bd2b248fea759bb33f1b0f3c2"
    }
  ],
  "vars": {
    "SITE_URL": "https://comments-test.suganthan.com",
    "FROM_EMAIL": "sugan@basicgravity.com"
  }
}
